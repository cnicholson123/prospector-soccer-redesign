{
  "name": "prospectorweb",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env scripts/dev.ts",
    "start": "tsx --env-file-if-exists=.env scripts/dev.ts --built",
    "build": "vite build --config admin/vite.config.ts && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright install chromium --only-shell",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "export:golden": "tsx scripts/export-golden.ts",
    "check-facts": "tsx scripts/check-facts.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@preact/signals": "^2.5.1",
    "@vercel/blob": "2.4.0",
    "@vercel/functions": "^3.11.0",
    "diff": "^9.0.0",
    "hono": "^4.10.4",
    "preact": "^10.27.2",
    "preact-iso": "^2.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.0.8"
  }
}
