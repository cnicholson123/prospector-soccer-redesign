# Local filesystem metadata and media. Production: postgres + private Vercel Blob.
# No Blob-KV driver is supported.
STORE_DRIVER=fs
DATA_DIR=.data
# DATABASE_URL=postgresql://... (Neon pooled TLS connection)
# BLOB_READ_WRITE_TOKEN= (private Blob store token; server only)
# Development generates an ephemeral secret if absent. Production requires 32+ bytes.
# SESSION_SECRET=
# Local single-user fallback (ADMIN_BOOTSTRAP_USER is a legacy alias).
ADMIN_BOOTSTRAP_USERNAME=Phil
# Development only. Keep plaintext credentials in your local environment.
ADMIN_BOOTSTRAP_PASSWORD=
# Production requires a secret JSON array of username, displayName, role and passwordHash.
# Generate each hash with npm run hash-password (hidden stdin). Never use real passwords in this file.
# ADMIN_BOOTSTRAP_USERS=
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
CACHE_SMAXAGE=0
CACHE_SWR=0
CDN_PURGE=off
# CRON_SECRET=
TZ_NAME=America/Los_Angeles
MAX_IMAGE_BYTES=8388608
MAX_FILE_BYTES=15728640
# Production: NODE_ENV=production, COOKIE_SECURE=true, CACHE_SMAXAGE=15,
# CACHE_SWR=300, CDN_PURGE=tag, # Production requires a secret JSON array of username, displayName, role and passwordHash.
# Generate each hash with npm run hash-password (hidden stdin). Never use real passwords in this file.
# ADMIN_BOOTSTRAP_USERS=
PUBLIC_BASE_URL=https://your-site.vercel.app
# Password changes are optional, including in production (Section 19).
ADMIN_FORCE_PASSWORD_CHANGE=false
