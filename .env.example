# Local filesystem metadata and media. Production: postgres + private Vercel Blob.
# No Blob-KV driver is supported.
STORE_DRIVER=fs
DATA_DIR=.data
# DATABASE_URL=postgresql://... (Neon pooled TLS connection)
# BLOB_READ_WRITE_TOKEN= (private Blob store token; server only)
# Development generates an ephemeral secret if absent. Production requires 32+ bytes.
# SESSION_SECRET=
# Local single-user fallback (ADMIN_BOOTSTRAP_USER is a legacy alias).
ADMIN_BOOTSTRAP_USERNAME=Phil
# Development only. Keep plaintext credentials in your local environment.
ADMIN_BOOTSTRAP_PASSWORD=
# Production requires a secret JSON array of username, displayName, role and passwordHash.
# Generate each hash with npm run hash-password (hidden stdin). Never use real passwords in this file.
# ADMIN_BOOTSTRAP_USERS=
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
CACHE_SMAXAGE=0
CACHE_SWR=0
CDN_PURGE=off
# Required in production. Use an independent random bearer secret.
# CRON_SECRET=
TZ_NAME=America/Los_Angeles
MAX_IMAGE_BYTES=8388608
MAX_FILE_BYTES=15728640
# Production also sets NODE_ENV=production, COOKIE_SECURE=true, CACHE_SMAXAGE=15,
# CACHE_SWR=300, CDN_PURGE=tag, and PUBLIC_BASE_URL=https://your-site.vercel.app.
# Bootstrap password changes are optional (Section 19). Admin-issued temporary passwords require a change.
ADMIN_FORCE_PASSWORD_CHANGE=false

# Browsable proof of concept. Defaults to disabled in every environment.
# enabled is accepted only with NODE_ENV=development or test, never production.
SHOP_CHECKOUT=disabled

# Per-user reserved original + web upload bytes per rolling 24 hours (256 MiB).
MAX_UPLOAD_BYTES_PER_DAY=268435456
