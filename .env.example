# Local filesystem metadata and media. Production: postgres + private Vercel Blob.
# No Blob-KV driver is supported.
STORE_DRIVER=fs
DATA_DIR=.data
# DATABASE_URL=postgresql://... (Neon pooled TLS connection)
# BLOB_READ_WRITE_TOKEN= (private Blob store token; server only)
# Development generates an ephemeral secret if absent. Production requires 32+ bytes.
# SESSION_SECRET=
ADMIN_BOOTSTRAP_USER=Phil
# Set locally; Chris's chosen value is not committed. Required in production.
ADMIN_BOOTSTRAP_PASSWORD=
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
CACHE_SMAXAGE=0
CACHE_SWR=0
CDN_PURGE=off
# CRON_SECRET=
TZ_NAME=America/Los_Angeles
MAX_IMAGE_BYTES=8388608
MAX_FILE_BYTES=15728640
# Production: NODE_ENV=production, COOKIE_SECURE=true, CACHE_SMAXAGE=15,
# CACHE_SWR=300, CDN_PURGE=tag, PUBLIC_BASE_URL=https://your-site.vercel.app
# Boolean; defaults true in production and false in development/test.
# Weak bootstrap users must change their password when enabled.
# ADMIN_FORCE_PASSWORD_CHANGE=true
